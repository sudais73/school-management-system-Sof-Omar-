{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}