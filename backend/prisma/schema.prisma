generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  fullName           String
  role               Role
  isVerified         Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  otp                String?
  otpExpiresAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  teacher Teacher?
    paymentsRecorded Payment[] @relation("PaymentRecordedBy")
  paymentsEdited   Payment[] @relation("PaymentEditedBy")
  student Student?
  @@map("users")
}

model Class {
  id        String      @id @default(cuid())
  className String
  capacity  Int?
  status    ClassStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  students Student[]
  subjects Subject[]
  attendances Attendance[] 
   gradeStructures GradeStructure[]
  homeroomTeacherId String?  @unique
  homeroomTeacher   Teacher? @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  feeStructures FeeStructure[]
  @@map("classes")
}

model Subject {
  id        String  @id @default(cuid())
  name      String
  classId   String
  teacherId String?

  class   Class    @relation(fields: [classId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])
 gradeStructures GradeStructure[]
 
  @@unique([classId, name])
  @@map("subjects")
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum Designation {
  TEACHER
  CASHIER
  ADMIN
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  employeeId String? @unique   // your reference calls this "staff number" — same thing
  gender     Gender?
  dateOfBirth DateTime?
  phone            String?
  alternatePhone   String?
  residentialAddress String?

  employmentDate DateTime?
  employmentType EmploymentType @default(FULL_TIME)
  department     String?
  designation    Designation    @default(TEACHER)

  highestQualification       String?
  specialization             String?
  professionalCertification  String?

  subjects     Subject[]
  attendances Attendance[] 
  classesOwned Class[] @relation("ClassHomeroomTeacher")
 gradeStructures GradeStructure[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}
enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  INACTIVE
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  admissionNumber String @unique

  firstName  String
  middleName String?
  lastName   String

  gender             Gender?
  dateOfBirth        DateTime?
  residentialAddress String?
  stateOfOrigin      String?
  nationality        String?
  fees StudentFee[]
  marks StudentMark[]
  attendanceRecords AttendanceRecord[]
  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  admissionDate  DateTime?
  previousSchool String?
  status         StudentStatus @default(ACTIVE)

  // Guardian info captured inline — not a separate login-linked model yet
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianOccupation   String?
  guardianEmail        String?
  guardianAddress      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
}

model FeeStructure {
  id          String   @id @default(cuid())
  classId     String
  session     String
  term        String
  name        String
  dueDate     DateTime
  description String?

  class       Class        @relation(fields: [classId], references: [id])
  items       FeeItem[]
  studentFees StudentFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, session, term])
  @@map("fee_structures")
}

model FeeItem {
  id             String @id @default(cuid())
  feeStructureId String
  name           String
  amount         Float

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("fee_items")
}

model StudentFee {
  id             String    @id @default(cuid())
  studentId      String
  feeStructureId String

  totalAmount Float
  amountPaid  Float     @default(0)
  balance     Float
  status      FeeStatus @default(PENDING)
  note        String?

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, feeStructureId])
  @@map("student_fees")
}

model Payment {
  id           String   @id @default(cuid())
  studentFeeId String

  amount        Float
  receiptNumber String?
  note          String?
  paymentDate   DateTime @default(now())

  recordedById String
  editedById   String?
  editedAt     DateTime?

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  editedBy   User?      @relation("PaymentEditedBy", fields: [editedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum ComponentStatus {
  DRAFT
  PUBLISHED
}

model GradeStructure {
  id        String @id @default(cuid())
  teacherId String
  classId   String
  subjectId String
  title     String
  term      String
  session   String

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  components GradeComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classId, subjectId, term, session])
  @@map("grade_structures")
}

model GradeComponent {
  id               String          @id @default(cuid())
  gradeStructureId String
  name             String
  maxScore         Float
  order            Int             @default(0)
  status           ComponentStatus @default(DRAFT)
  publishedAt      DateTime?

  gradeStructure GradeStructure @relation(fields: [gradeStructureId], references: [id], onDelete: Cascade)
  studentMarks   StudentMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gradeStructureId])
  @@map("grade_components")
}

model StudentMark {
  id               String @id @default(cuid())
  gradeComponentId String
  studentId        String
  score            Float

  gradeComponent GradeComponent @relation(fields: [gradeComponentId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeComponentId, studentId])
  @@map("student_marks")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  date      DateTime // date-only — always normalized to midnight, see note below

  class   Class   @relation(fields: [classId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, date])
  @@index([classId])
  @@index([teacherId])
  @@map("attendances")
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  attendanceId String
  studentId    String
  status       AttendanceStatus @default(ABSENT)
  note         String?

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceId, studentId])
  @@index([attendanceId])
  @@index([studentId])
  @@map("attendance_records")
}