generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  fullName           String
  role               Role
  isVerified         Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  otp                String?
  otpExpiresAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  teacher Teacher?
  student Student?
  @@map("users")
}

model Class {
  id        String      @id @default(cuid())
  className String
  capacity  Int?
  status    ClassStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  students Student[]
  subjects Subject[]
  
  homeroomTeacherId String?  @unique
  homeroomTeacher   Teacher? @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  @@map("classes")
}

model Subject {
  id        String  @id @default(cuid())
  name      String
  classId   String
  teacherId String?

  class   Class    @relation(fields: [classId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, name])
  @@map("subjects")
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum Designation {
  TEACHER
  CASHIER
  ADMIN
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  employeeId String? @unique   // your reference calls this "staff number" — same thing
  gender     Gender?
  dateOfBirth DateTime?
  phone            String?
  alternatePhone   String?
  residentialAddress String?

  employmentDate DateTime?
  employmentType EmploymentType @default(FULL_TIME)
  department     String?
  designation    Designation    @default(TEACHER)

  highestQualification       String?
  specialization             String?
  professionalCertification  String?

  subjects     Subject[]
  classesOwned Class[] @relation("ClassHomeroomTeacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}
enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  INACTIVE
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  admissionNumber String @unique

  firstName  String
  middleName String?
  lastName   String

  gender             Gender?
  dateOfBirth        DateTime?
  residentialAddress String?
  stateOfOrigin      String?
  nationality        String?

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  admissionDate  DateTime?
  previousSchool String?
  status         StudentStatus @default(ACTIVE)

  // Guardian info captured inline — not a separate login-linked model yet
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianOccupation   String?
  guardianEmail        String?
  guardianAddress      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}